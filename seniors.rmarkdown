# Confidence Intervals

### Confidence interval for the population mean (unknown variance)

```{r}
CI_m <- function (x, ci = 0.95)
{
  standard_deviation <- sd(x)
  sample_size <- length(x)
  Margin_Error <- abs(qt((1-ci)/2,df=sample_size-1))* standard_deviation/sqrt(sample_size)
df_out <- 
  data.frame( 
    sample_size=length(x),
    Mean=mean(x), sd=sd(x),
    Margin_Error=Margin_Error,
    'CI lower limit'=(mean(x) - Margin_Error),
    'CI Upper limit'=(mean(x) + Margin_Error)) |>
    tidyr::pivot_longer(
      names_to = "Measurements",
      values_to ="values", 1:6
      )
  return(df_out)
}
# Example. Compute 95% confidence interval for the mean of 'Value' in the population
CI_m(data.df$value, ci=0.95)
```

### Creating a Sample from an Existing Population

```{r}
set.seed(1)
sample1 <- 
  rnorm(n=50, mean=5.44, sd=2)
sample2 <- 
  rnorm(n=75, mean=5.44, sd=2)
sample3 <- 
  rnorm(n=60, mean=5.44, sd=2)
sample4 <- 
  rnorm(n=100, mean=5.44, sd=2)
sample5 <- 
  rnorm(n=150, mean=5.44, sd=2)
CI_m(sample1, ci=0.50)
CI_m(sample2, ci=0.50)
CI_m(sample3, ci=0.50)
CI_m(sample4, ci=0.50)
CI_m(sample5, ci=0.50)
```

### Confidence interval for the population proportion in a Bernoulli distribution

```{r}
CI_p <- function(x, ci = 95)
{
  vcat<-na.omit(x)
  p <- mean(x)
  standard_deviation <- sqrt(p*(1-p))
  sample_size <- length(x)
  Margin_Error <- abs(qnorm((1-ci)/2))* standard_deviation/sqrt(sample_size)
  df_out <- 
    data.frame(
      sample_size=length(x),
      p,
      Margin_Error=Margin_Error,
      'CI lower limit'=(p - Margin_Error),
      'CI Upper limit'=(p + Margin_Error)) |>
    tidyr::pivot_longer(
      names_to = "Measurements",
      values_to ="values", 1:5
      )
  return(df_out)
}
```

------------------------------------------------------------------------

Example. Compute 95% confidence interval for the population proportion of consumers that give 5 or more to 'Value'

```{r}
prop <- ifelse(data.df$value > 5, 1, 0) #Generate the Bernoulli sample with 1(meet the condition) and 0
prop.table(table(prop))

CI_p(prop ,ci=0.95)
```

Plot 95% confidence intervals for 'Value' divided by gender.

Function "summarySE" in the library Rmisc allow us to summarise one variable divided in groups.

```{r}
df <- summarySE(data.df, measurevar="value", groupvars="gender", na.rm=T)

graf.point1 <- ggplot(df, aes(x=gender, y=value)) + 
  geom_point(size = 3) + ylim(3, 5)
graf.point1
graf.point <- graf.point1 +  geom_errorbar(aes(ymin=value-ci, ymax=value+ci), width = 0.2) +  ylab("Importance") + 
  ggtitle("95% Confidence interval for the mean importance of Value by gender")
graf.point
```

Plot 95% confidence intervals for 'Value' divided by gender and age.

```{r}
df <- summarySE(data.df, measurevar="value", groupvars=c("gender","age"), na.rm=T)

graf.point1 <- ggplot(df, aes(x=age, y=value, colour=gender)) + 
  geom_point(size = 3) + ylim(3, 5.5)
graf.point1
graf.point <- graf.point1 +  geom_errorbar(aes(ymin=value-ci, ymax=value+ci), width = 0.2) +  ylab("Importance") + 
  ggtitle("95% Confidence interval for the mean importance of Value by gender and age")
graf.point
```

Plot 95% confidence intervals for 'Coup' divided by gender and age.

```{r}
df <- summarySE(data.df, measurevar="coup", groupvars=c("gender","age"), na.rm=T)

graf.point1 <- ggplot(df, aes(x=age, y=coup, colour=gender)) + 
  geom_point(size = 2) + ylim(1, 5.5)
graf.point1
graf.point <- graf.point1 +  geom_errorbar(aes(ymin=coup-ci, ymax=coup+ci), width = 0.2) +  ylab("Importance") + 
  ggtitle("95% Confidence interval for the mean importance of Coupons by gender and age")
graf.point
```

# Hypothesis Testing

#### One-Sided Hypothesis Testing

The hypothesis is price = 4 and alternative price is greater than 4.

```{r}
#H0: mu_{price}=4; H1: mu_{price}<4 (slide 13/33 to 15/33)
t.test(data.df$price, y=NULL,alternative="less",mu=4)
qt(0.05,309) 

#H0: mu_{price}=4; H1: mu_{price}>4
t.test(data.df$price, y=NULL,alternative="greater",mu=4)
qt(0.95,309) 
```

#### Two-Sided Hypothesis Testing

```{r}
#H0: mu_{price}=4; H1: mu_{price}/=4
t.test(data.df$price, y=NULL,alternative="two.sided",mu=4)
qt(0.975,309)
qt(0.025,309)
```

#### Proportional Hypothesis Testing

```{r}
#H0: p{price>4}=0.35; H1: p_{price>4}>0.35 (slide 16/33)
prop <- ifelse(data.df$price>4, 1, 0) #Generate the Bernoulli sample with 1(meet the condition) and 0
t.test(prop, y=NULL,alternative="greater",mu=0.35)
qnorm(0.95)
```

#### Paired T-Test

```{r}
#Paired test for equal mean importance for price and value (slide 18/33 to 19/33)
#----------------------------------------------------------
t.test(data.df$price, y=data.df$value,paired=TRUE,alternative="greater")
qt(0.95,309)
# opposite
t.test(data.df$value, y=data.df$price,paired=TRUE,alternative="greater")
```

#### Proportional Paired T-Test (Slide 25)

```{r}
#Paired test for differences among the proportion of consumers giving importance >4 to price and value bigger than 0.2 (slide 20/33)
#---------------------------------------------------------------------------
propP <- ifelse(data.df$price>4, 1, 0)
propV <- ifelse(data.df$value>4, 1, 0)
t.test(propV, y=propP,paired=TRUE,alternative="greater",mu=0.2)
qnorm(0.95)
```

#### Independent T-Test

```{r}
#Independent t-test for equal means of price for male and females (slides 22-23)
#--------------------------------------------------------------------------------

s<-split(data.df$price,data.df$gender)#splits the variable price in two groups by gender
#first step: test for equal variances
var.test(s$male, s$female, alternative = "two.sided")
qf(0.975,108,200)
#second step: test for differences of means
t.test(s$male, y=s$female,alternative="two.sided",mu=0,var.equal=TRUE)
qt(0.975,308)
qt(0.025,308)
```

#### Proportional Independent T-Test

```{r}
#Independent t-test for equal proportions of price>5 for male and females (slides 24-25)
#---------------------------------------------------------------------------------------
propP <- ifelse(data.df$price>5, 1, 0)

s<-split(propP,data.df$gender)#splits the variable price in two groups by gender
#first step: test for equal variances
var.test(s$male, s$female, alternative = "two.sided")
qf(0.975,108,200)
#second step: test for differences of means
t.test(s$male, y=s$female,alternative="two.sided",mu=0,var.equal=FALSE)
qt(0.975,308)
```

#### ANOVA Analysis

ANOVA (Analysis of Variance) is a statistical test used to compare the means of three or more independent groups to determine if there is a significant difference among them.

-   It is used when you have three or more groups to compare, unlike a t-test which is for two groups. 

-   It helps test the effect of one or more independent variables (factors) on a quantitative dependent variable.

-   A "two-way" or "factorial" ANOVA can examine the effects of two independent variables at once and their potential interaction. 

##### One-way analysis

```{r}
#boxplot of price by income
ggboxplot(data.df, x = "income", y = "value", 
          color = "income", palette = c("#00AFBB", "#E7B800", "#FC4E07","orange", "green"),
          order = c("<1250", "1250-1875", "1876-2500","2501-3750",">3750","I prefer not to answer"),
          ylab = "Price", xlab = "Income")
# Compute the analysis of variance
res.aov <- aov(value ~ income, data = data.df)
# Summary of the analysis
summary(res.aov)
```

##### One-way analysis (again)

```{r}
#boxplot of price by income
ggboxplot(data.df, x = "education", y = "price", 
          color = "education", palette = c("#00AFBB", "#E7B800", "#FC4E07"),
          order = c("Elementary", "High school", "University degree"),
          ylab = "Price", xlab = "education")
# Compute the analysis of variance
res.aov <- aov(value ~ income, data = data.df)
# Summary of the analysis
summary(res.aov)
```

##### Two-way analysis

```{r}
#Boxplots 'Coup' divided by gender and age.

ggboxplot(data.df, x = "age", y = "coup", color = "gender",
          palette = c("#00AFBB", "#E7B800","orange"))
res.aov <- aov(value ~ age+gender, data = data.df)
summary(res.aov)
data_df_grouped <- group_by(data.df,gender,age)

data_df_summary <-data_df_grouped %>%
  summarise_at(vars(coup),
               list(avg=mean,stde=sd))
data_df_summary

TukeyHSD(res.aov, which = "age")
plot(TukeyHSD(res.aov, "age"))
```

## Associative Analysis

#### Volume Plot

```{r}
library(gplots) # For balloonplot
library(lsr) # For Cramers'V

# 1. Contingency table for RankA and age
ConTtable<-table(data.df$rankA,data.df$age)
RConTtable<-prop.table(ConTtable)*100

# 2. Graphical visualization of the table.
balloonplot(t(RConTtable), main ="rankA", xlab ="", ylab="",
            label = FALSE, show.margins = FALSE)

#3. Chi-squared Test
chisq.test(data.df$rankA,y=data.df$age)
cramersV(ConTtable)

# 1. Contingency table for RankAA and age
ConTtable<-table(data.df$rankAA,data.df$age)
RConTtable<-prop.table(ConTtable)*100
# 2. Graphical visualization of the table.
balloonplot(t(RConTtable), main ="rankAA", xlab ="", ylab="",
            label = FALSE, show.margins = FALSE)

```

#### Chi-Squared Test

```{r}
#3. Chi-squared Test
chisq.test(data.df$rankAA,y=data.df$age)
cramersV(ConTtable)
```

### Another Example

##### Libraries

```{r}
library(Hmisc)
library(corrplot)
library(PerformanceAnalytics)
```

##### Volume Plot

```{r}
data.dfB<-data.frame(dataseniors[1:310,2:13])
#Correlation matrix
res <- round(cor(data.dfB),2)
#correlation matrix with p-values
res2 <- rcorr(as.matrix(data.dfB))
res2
#Visualization of the data matrix
corrplot(res, type = "upper", order = "hclust", 
         tl.col = "black", tl.srt = 45)
```

##### Matrix of Scatter Plots

```{r}
